# Copiar a .env y completar. El .env NO se commitea.

# Conexión a Postgres.
# Supabase: Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# Poner en "true" contra Supabase u otro Postgres administrado.
# En un Postgres local dejarlo en "false".
DATABASE_SSL=true

# Secreto para firmar los JWT. Generar uno propio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio

# Cuánto dura el token de sesión
JWT_EXPIRES_IN=8h

PORT=3000

# Origen permitido para el frontend (Vite en dev, Vercel en prod).
# Separar varios con coma.
CORS_ORIGIN=http://localhost:5173
